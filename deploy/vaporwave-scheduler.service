[Unit]
Description=Vaporwave sync and scan scheduler
After=network-online.target vaporwave-backend.service
Wants=network-online.target

[Service]
Type=simple
User=vaporwave
Group=vaporwave
WorkingDirectory=/opt/vaporwave
Environment=LD_LIBRARY_PATH=/opt/vaporwave/lib
Environment=TZ=Asia/Shanghai
ExecStart=/opt/vaporwave/bin/vaporwave-sidecar --db /opt/vaporwave/data/market_data.db --scheduler run --interval-seconds 300
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
